@page "/men"
@using BlazorServerApp_Server.Services
@using BlazorServerApp_Server.Data.Model
@rendermode InteractiveServer

@inject ProductService ProductService

<PageTitle>Men's Collection</PageTitle>

<div class="page-container">
    <h1 class="page-title">Men's Collection</h1>
    <p class="page-subtitle">Explore our latest styles for men.</p>

    <div class="category-links">
        <a href="/men/shoes">Shoes</a>
        <a href="/men/bags">Bags</a>
        <a href="/men/glasses">Glasses</a>
    </div>

    <div class="product-grid">
        @if (_products == null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            @foreach (var product in _products)
            {
                <ProductCard Product="@product" />
            }
        }
    </div>
</div>

@code {
    private List<Data.Model.Product>? _products;

    protected override async Task OnInitializedAsync()
    {
        _products = await ProductService.GetProductsAsync("men");
    }
}