@page "/heavyreport" 
@using BlazorServerApp_Server.Redis
@inject RedisHtmlCache Cache
@inject ILogger<ReportPrerendered> Logger

<PageTitle>Heavy Report</PageTitle>

@if (isLoading)
{
    <p><em>Loading report from cache...</em></p>
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else if (hasCachedHtml && !string.IsNullOrEmpty(cachedHtml))
{
    <p><em>Displaying report from Redis cache.</em></p>
    @((MarkupString)cachedHtml)
}
else
{
    <p><em>Cache miss for Heavy Report. Rendering live report.</em></p>
    <Report /> 
}

@code {
    private string? cachedHtml;
    private bool hasCachedHtml = false;
    private bool isLoading = true; // New state variable for loading indicator

    protected override async Task OnInitializedAsync() // <-- Changed to async Task
    {
        Logger.LogInformation("HeavyReport: OnInitializedAsync called to check Redis cache.");

        isLoading = true; // Set loading state to true
        try
        {
            // Await the asynchronous method correctly
            // Use the key that your BackgroundPagePrerenderer uses to store the HTML for "ReportPrerendered"
            string? html = await Cache.GetHtmlAsync("ReportPrerendered");

            if (!string.IsNullOrEmpty(html))
            {
                cachedHtml = html;
                hasCachedHtml = true;
                Logger.LogInformation("HeavyReport: HTML found in cache.");

                // TODO: Da li ovo da se brise? (Should this be deleted?)
                // If you want to serve the cached HTML only once, then clearing it here makes sense.
                // Ensure you're calling the correct RedisHtmlCache methods.
                // Assuming "ReportPrerendered" stores the HTML, and "ReportPrerendered_Data" stores the associated object data.

                await Cache.ClearHtmlAsync("ReportPrerendered");         // Clear the HTML entry
                await Cache.ClearStringArrayDataAsync("ReportPrerendered_Data"); // Clear the associated object data entry (using the generic ClearDataAsync)

                // If "ReportPrerendered" itself was the key for string array data, then:
                // await Cache.ClearStringArrayDataAsync("ReportPrerendered");
            }
            else
            {
                hasCachedHtml = false;
                Logger.LogInformation("HeavyReport: HTML not found in cache.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "HeavyReport: Error retrieving or clearing cache for ReportPrerendered. Falling back to live rendering.", ex.Message);
            hasCachedHtml = false; // Fallback to live rendering on error
            cachedHtml = null;
        }
        finally
        {
            isLoading = false; // Set loading state to false after operation completes (or fails)
        }
    }
}