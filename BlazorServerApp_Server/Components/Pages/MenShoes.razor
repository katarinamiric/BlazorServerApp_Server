@page "/men/shoes"
@using BlazorServerApp_Server.Services
@using BlazorServerApp_Server.Data.Model
@rendermode InteractiveServer

@inject ProductService ProductService

<PageTitle>Men's Shoes</PageTitle>

<div class="page-container">
    <h1 class="page-title">Men's Shoes</h1>
    <p class="page-subtitle">Step up your style with our selection of shoes.</p>

    <div class="product-grid">
        @if (_products == null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            @foreach (var product in _products)
            {
                <ProductCard Product="@product" />
            }
        }
    </div>
</div>

@code {
    private List<Data.Model.Product>? _products;

    protected override async Task OnInitializedAsync()
    {
        _products = await ProductService.GetProductsAsync("men/shoes");
    }
}