@using System.Reflection
@using Microsoft.AspNetCore.Components.Routing
@using BlazorServerApp_Server.Components.Layout
@using BlazorServerApp_Server.Components.Pages 
@using BlazorServerApp_Server 
@using BlazorServerApp_Server.Components.Pages 
@using BlazorServerApp_Server.Services

@using Microsoft.Identity.Client
// Assuming your Prerenderer is in root namespace
@inject IServiceScopeFactory ScopeFactory

<Router AppAssembly="@typeof(App).Assembly" OnNavigateAsync="OnNavigateAsync">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>

@code {

    // [Inject] NavigationTracker NavTracker { get; set; }
    [Inject] NavigationRuleEngine RuleEngine { get; set; }
    [Inject] BackgroundPagePrerenderer Prerenderer { get; set; }
    [Inject] ILogger<Routes> Logger { get; set; }
    // [Inject] BrowserHistoryService BrowserHistory { get; set; }

    private async Task OnNavigateAsync(NavigationContext context)
    {
        // var currentPage = context.Path; // Use context.Path for the current navigation.
        // NavTracker.Update(currentPage);

        // var pagesToPrerender = RuleEngine.GetPagesToPrerender(currentPage);
        // foreach (var page in pagesToPrerender)
        // {
        //     // Map URL path to Component types manually
        //     if (page == "/weather") // Ensure your pages are correctly referenced, e.g., using @using
        //         await Prerenderer.PrerenderComponentAsync<Weather>();
        //     else if (page == "/weather2") // Make sure this path corresponds to Counter, not Weather2
        //         await Prerenderer.PrerenderComponentAsync<Weather2>();
        //     // Adjust your paths based on your actual route attributes:
        //     // Counter page often has @page "/counter"
        //     // Weather page often has @page "/weather" or similar
        // }

        var currentPage = context.Path;
        // NavTracker.Update(currentPage); 

        Logger.LogInformation($"Navigation detected to: {currentPage}. Initiating background prerendering tasks...");


        // var pagesToPrerenderUrls = NavigationPredictorService.PredictNextPages(currentPage);
        var pagesToPrerenderUrls = await RuleEngine.GetPagesToPrerender(currentPage);

        foreach (var pageUrl in pagesToPrerenderUrls)
        {
            var pageType = RuleEngine.GetPageTypeFromUrl(pageUrl); 

            if (pageType != null)
            {
                _ = Task.Run(async () =>
                {
                  
                    using (var scope = ScopeFactory.CreateScope())
                    {
                        var backgroundPrerenderer = scope.ServiceProvider.GetRequiredService<BackgroundPagePrerenderer>();
                        var taskLogger = scope.ServiceProvider.GetRequiredService<ILogger<Routes>>();

                        try
                        {
                            taskLogger.LogInformation($"Background Prerender starting for: {pageUrl} (in new scope).");

                            var prerenderMethod = typeof(BackgroundPagePrerenderer)
                                .GetMethod(nameof(BackgroundPagePrerenderer.PrerenderComponentAsync), BindingFlags.Public | BindingFlags.Instance);

                            if (prerenderMethod != null)
                            {
                                var genericPrerenderMethod = prerenderMethod.MakeGenericMethod(pageType);
                                await (Task)genericPrerenderMethod.Invoke(backgroundPrerenderer, null)!;
                                taskLogger.LogInformation($"Background Prerender completed for: {pageUrl} (in new scope).");
                            }
                            else
                            {
                                taskLogger.LogError($"PrerenderComponentAsync method not found on BackgroundPagePrerenderer. Make sure it's public and instance. Type: {pageType.Name}");
                            }
                        }
                        catch (Exception ex)
                        {
                            taskLogger.LogError(ex, $"Error during background prerender for {pageUrl} (in new scope).");
                        }
                    }
                });
            }
            else
            {
                Logger.LogWarning($"No Blazor page Type found for URL: '{pageUrl}' via RuleEngine.GetPageTypeFromUrl. Skipping background prerender.");
            }
        }
    }

}